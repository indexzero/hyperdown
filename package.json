{
  "name": "hyperwiki2",
  "version": "0.0.0",
  "description": "a wiki implementatin on top of autobee ",
  "license": "Apache-2.0",
  "author": "Charlie Robbins <npm@charlie.dev>",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:regressions": "node --test \"test/regressions/*.test.js\"",
    "test:harness:clean": "HARNESS_PROFILE=clean node --test --test-concurrency=1 \"harness/scenarios/*.test.js\"",
    "test:harness:lossy": "HARNESS_PROFILE=lossy node --test --test-concurrency=1 \"harness/scenarios/*.test.js\"",
    "test:harness:partitioned": "HARNESS_PROFILE=partitioned node --test --test-concurrency=1 \"harness/scenarios/*.test.js\"",
    "test:harness:fuzz": "HARNESS_PROFILE=clean HARNESS_FUZZ_ITERS=10 node --test \"harness/scenarios/s10-fuzz.test.js\"",
    "test:harness:soak": "node harness/soak/soak.js"
  },
  "devDependencies": {
    "@hyperwiki/cli": "workspace:*",
    "@hyperwiki/core": "workspace:*",
    "@hyperwiki/faces": "workspace:*",
    "@hyperwiki/store": "workspace:*",
    "n3": "^2.1.1"
  }
}
